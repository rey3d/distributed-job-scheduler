  "info": {
    "title": "Distributed Job Scheduling Platform API",
    "description": "Multi-tenant REST API for managing organizations, projects, job queues, executions, retry policies, and monitoring.",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "User registration and JWT authentication"
    },
    {
      "name": "Organizations",
      "description": "Tenant boundaries and management"
    },
    {
      "name": "Projects",
      "description": "Project containers belonging to organizations"
    },
    {
      "name": "Queues",
      "description": "Job queue configuration, priority, and pause/resume controls"
    },
    {
      "name": "Jobs",
      "description": "Job enqueuing, scheduling, inspection, DLQ retry, and cancellation"
    },
    {
      "name": "Workers & Monitoring",
      "description": "Worker fleet status, DLQ entries, and aggregated dashboard metrics"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@acme.com"
          },
          "password": {
            "type": "string",
            "example": "password123",
            "minLength": 6
          },
          "organizationName": {
            "type": "string",
            "example": "Acme Operations Corp"
          },
          "organizationSlug": {
            "type": "string",
            "example": "acme-ops"
          }
        },
        "required": [
          "email",
          "password",
          "organizationName"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "owner@acme.com"
          },
          "password": {
            "type": "string",
            "example": "password123"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateOrganizationDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Stark Industries"
          },
          "slug": {
            "type": "string",
            "example": "stark-ind"
          }
        },
        "required": [
          "name"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Payment Core Service"
